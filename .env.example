# ============================================================
# HomeNest - environment configuration
# Copy this file to ".env" and edit the values.
# NEVER commit your real .env file (it is in .gitignore).
# ============================================================

# --- Flask ---
# Development mode: 1 = debug pages + auto reload. Use 0 in production.
FLASK_DEBUG=1
PORT=5000

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 only when serving over HTTPS (production).
COOKIE_SECURE=0

# --- OTP (email verification) limits ---
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_15_MINUTES=3
OTP_MAX_VERIFY_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5

# --- SMTP email delivery (Gmail example) ---
# 1. Enable 2-step verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put the 16-character app password below (NOT your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
MAIL_FROM_NAME=HomeNest

# --- Development helper ---
# 1 = when SMTP is NOT configured, print the OTP in the server console
#     instead of emailing it (LOCAL DEVELOPMENT ONLY - never use in
#     production, and remove this line when you deploy).
OTP_DEV_CONSOLE=1
